<?xml version="1.0" encoding="UTF-8"?>
<map>
    <n>Map 9 Two Routes at Different Altitudes</n>
    <description>
        2 routes paralleles dans le meme sens (x croissant)
        a des altitudes differentes.
        Route Basse : z=20, Route Haute : z=80.
        Start et goal hors des routes (vol libre au debut et a la fin).
        Le drone choisit l'une des deux routes intermediaires.
        Pas d'obstacles.
    </description>
    <scenario_id>9</scenario_id>

    <mission>
        <start>
            <x>0</x>
            <y>0</y>
            <z>0</z>
        </start>
        <goal>
            <x>500</x>
            <y>0</y>
            <z>100</z>
        </goal>
    </mission>

    <!--
        Route Basse : z=20, x: 80->420, sens x croissant
        Route Haute : z=80, x: 80->420, sens x croissant
        80m de vol libre au depart et a l'arrivee
        Width = 30m
    -->
    <airways>

        <airway>
            <n>Route Basse</n>
            <type>mandatory</type>
            <waypoint_start>
                <x>80</x>
                <y>0</y>
                <z>20</z>
            </waypoint_start>
            <waypoint_end>
                <x>420</x>
                <y>0</y>
                <z>20</z>
            </waypoint_end>
            <width>30</width>
            <altitude_min>5</altitude_min>
            <altitude_max>35</altitude_max>
        </airway>

        <airway>
            <n>Route Haute</n>
            <type>mandatory</type>
            <waypoint_start>
                <x>80</x>
                <y>0</y>
                <z>80</z>
            </waypoint_start>
            <waypoint_end>
                <x>420</x>
                <y>0</y>
                <z>80</z>
            </waypoint_end>
            <width>30</width>
            <altitude_min>65</altitude_min>
            <altitude_max>95</altitude_max>
        </airway>

    </airways>

    <obstacles>
    </obstacles>

</map>